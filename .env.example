# Optional paid: Vercel Marketplace Redis (skip if using JSONBin below)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional server-side JSONBin (default bin 6a5d13b1f5f4af5e29a49985 — client sync uses built-in keys)
JSONBIN_COW_BIN_ID=6a5d13b1f5f4af5e29a49985
JSONBIN_API_KEY=

# Clerk — https://dashboard.clerk.com → API Keys (never commit real values)
CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Local: npx vercel env pull .env.local
# Enable "Username" in Clerk → User & authentication → Email, phone, username

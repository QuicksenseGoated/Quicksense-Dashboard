{
  "name": "quicksense-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:vercel": "vercel dev --listen 3000",
    "dev:static": "npx --yes serve . -l 3000",
    "check": "node scripts/check.mjs",
    "setup:clerk": "clerk env pull",
    "deploy": "vercel --prod",
    "start": "npm run dev"
  },
  "dependencies": {
    "@clerk/backend": "^2.17.0",
    "@clerk/clerk-js": "^5.128.0",
    "@vercel/kv": "^3.0.0"
  },
  "devDependencies": {
    "vercel": "^41.6.0"
  }
}
